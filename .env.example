# Copie este arquivo para .env.development.local durante o desenvolvimento.
# Em produção, configure as mesmas variáveis no ambiente de deploy.
VITE_APP_NAME=ProFind
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Imagens: use "mock" apenas em desenvolvimento, "disabled" para desativar ou
# "backend" para um proxy seguro. Nunca exponha segredo de provedor em VITE_*.
VITE_IMAGE_PROVIDER=mock
VITE_IMAGE_API_BASE_URL=

# Opcional: necessário somente quando Analytics for configurado futuramente.
VITE_FIREBASE_MEASUREMENT_ID=
