# Copie este arquivo para .env.development.local durante o desenvolvimento.
# Em produção, configure as mesmas variáveis no ambiente de deploy.
VITE_APP_NAME=ProFind
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Imagens: ImageKit é o provider real. "mock" deve ser selecionado explicitamente
# somente em testes; "disabled" desativa upload e "backend" preserva o adapter genérico.
# Nunca use IMAGEKIT_PRIVATE_KEY com prefixo VITE_ ou no frontend.
VITE_IMAGE_PROVIDER=imagekit
VITE_IMAGE_API_BASE_URL=
VITE_IMAGEKIT_PUBLIC_KEY=your-public-key
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id
# Local: http://localhost:8787/api/imagekit/auth
# Produção: https://profind-imagekit.<account-subdomain>.workers.dev/api/imagekit/auth
VITE_IMAGEKIT_AUTH_ENDPOINT=http://localhost:8787/api/imagekit/auth

# Opcional: necessário somente quando Analytics for configurado futuramente.
VITE_FIREBASE_MEASUREMENT_ID=
