rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDocumentOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isActiveAdmin() {
      let accessPath = /databases/$(database)/documents/adminAccess/$(request.auth.uid);

      return request.auth != null
        && exists(accessPath)
        && get(accessPath).data.active == true
        && get(accessPath).data.schemaVersion == 1;
    }

    function hasApprovedOperationalProfile(professionalId) {
      let accessPath = /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId);
      let profilePath = /databases/$(database)/documents/professionalProfiles/$(professionalId);
      let access = get(accessPath).data;
      let profile = get(profilePath).data;

      return request.auth != null
        && request.auth.uid == professionalId
        && exists(accessPath)
        && exists(profilePath)
        && access.professionalId == professionalId
        && access.reviewStatus == 'APPROVED'
        && access.active == true
        && access.profileVersion is int
        && access.profileVersion > 0
        && access.approvedVersion == access.profileVersion
        && access.approvedCategoryIds is list
        && access.approvedSpecialtyIds is list
        && access.approvedSelectedCityIbgeCodes is list
        && access.eligibleCityIbgeCodes is list
        && profile.ownerId == professionalId
        && profile.status == 'PUBLISHED'
        && profile.categoryIds == access.approvedCategoryIds
        && profile.specialtyIds == access.approvedSpecialtyIds
        && profile.baseLocation.ibgeCode == access.approvedBaseCityIbgeCode
        && profile.get('selectedCityIbgeCodes', [])
          == access.approvedSelectedCityIbgeCodes;
    }

    function professionalMatchesRequest(summary, professionalId) {
      let access = get(
        /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
      ).data;

      return hasApprovedOperationalProfile(professionalId)
        && summary.clientId != professionalId
        && summary.categoryId in access.approvedCategoryIds
        && summary.specialtyId in access.approvedSpecialtyIds
        && summary.cityIbgeCode in access.eligibleCityIbgeCodes
        && !(professionalId in summary.excludedProfessionalIds);
    }

    function professionalMatchesOpportunity(summary, professionalId) {
      let access = get(
        /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
      ).data;

      return hasApprovedOperationalProfile(professionalId)
        && summary.categoryId in access.approvedCategoryIds
        && summary.specialtyId in access.approvedSpecialtyIds
        && summary.cityIbgeCode in access.eligibleCityIbgeCodes;
    }

    function hasAvailableServiceSlot(summary, professionalId) {
      let slotId = summary.serviceDate + '_' + summary.period;
      let availabilityPath = /databases/$(database)/documents/professionalAvailability/$(professionalId)/slots/$(slotId);
      let availability = get(availabilityPath).data;

      return exists(availabilityPath)
        && availability.professionalId == professionalId
        && availability.serviceDate == summary.serviceDate
        && availability.period == summary.period
        && availability.available == true;
    }

    function hasValidAcceptanceDocuments(requestId, professionalId, before, after) {
      let assignmentPath = /databases/$(database)/documents/serviceRequests/$(requestId)/assignments/$(after.currentAssignmentId);
      let assignment = getAfter(assignmentPath).data;
      let reservationPath = /databases/$(database)/documents/professionalReservations/$(professionalId)/slots/$(assignment.reservationId);
      let reservation = getAfter(reservationPath).data;
      let roundPath = /databases/$(database)/documents/serviceRequests/$(requestId)/rounds/$(before.currentRoundId);
      let round = getAfter(roundPath).data;
      let eventPath = /databases/$(database)/documents/serviceRequests/$(requestId)/events/$(assignment.acceptedEventId);
      let event = getAfter(eventPath).data;

      return !exists(assignmentPath)
        && !exists(reservationPath)
        && !exists(eventPath)
        && existsAfter(assignmentPath)
        && existsAfter(reservationPath)
        && existsAfter(roundPath)
        && existsAfter(eventPath)
        && get(roundPath).data.status == 'OPEN'
        && round.diff(get(roundPath).data).affectedKeys().hasOnly([
          'status', 'closedAt', 'closedReason', 'updatedAt'
        ])
        && round.status == 'CLOSED'
        && round.closedAt == request.time
        && round.closedReason == 'ASSIGNED'
        && round.updatedAt == request.time
        && assignment.keys().hasAll([
          'assignmentId', 'requestId', 'clientId', 'professionalId',
          'round', 'status', 'serviceDate', 'period', 'reservationId',
          'acceptedEventId', 'acceptedAt', 'endedAt', 'endReason'
        ])
        && assignment.keys().hasOnly([
          'assignmentId', 'requestId', 'clientId', 'professionalId',
          'round', 'status', 'serviceDate', 'period', 'reservationId',
          'acceptedEventId', 'acceptedAt', 'endedAt', 'endReason'
        ])
        && assignment.assignmentId == after.currentAssignmentId
        && assignment.requestId == requestId
        && assignment.clientId == before.clientId
        && assignment.professionalId == professionalId
        && assignment.round == before.round
        && assignment.status == 'ACTIVE'
        && assignment.serviceDate == before.serviceDate
        && assignment.period == before.period
        && assignment.reservationId == before.serviceDate + '_' + before.period
        && assignment.acceptedAt == request.time
        && assignment.endedAt == null
        && assignment.endReason == null
        && reservation.keys().hasAll([
          'reservationId', 'professionalId', 'requestId', 'assignmentId',
          'serviceDate', 'period', 'round', 'createdAt'
        ])
        && reservation.keys().hasOnly([
          'reservationId', 'professionalId', 'requestId', 'assignmentId',
          'serviceDate', 'period', 'round', 'createdAt'
        ])
        && reservation.reservationId == assignment.reservationId
        && reservation.professionalId == professionalId
        && reservation.requestId == requestId
        && reservation.assignmentId == assignment.assignmentId
        && reservation.serviceDate == before.serviceDate
        && reservation.period == before.period
        && reservation.round == before.round
        && reservation.createdAt == request.time
        && event.keys().hasAll([
          'eventId', 'entityType', 'entityId', 'requestId', 'type',
          'reasonCode', 'actorId', 'actorRole', 'round', 'assignmentId',
          'fromStatus', 'toStatus', 'createdAt'
        ])
        && event.keys().hasOnly([
          'eventId', 'entityType', 'entityId', 'requestId', 'type',
          'reasonCode', 'actorId', 'actorRole', 'round', 'assignmentId',
          'fromStatus', 'toStatus', 'createdAt'
        ])
        && event.eventId == assignment.acceptedEventId
        && event.entityType == 'SERVICE_REQUEST'
        && event.entityId == requestId
        && event.requestId == requestId
        && event.type == 'REQUEST_ASSIGNED'
        && event.reasonCode == 'PROFESSIONAL_ACCEPTANCE'
        && event.actorId == professionalId
        && event.actorRole == 'PROFESSIONAL'
        && event.round == before.round
        && event.assignmentId == assignment.assignmentId
        && event.fromStatus == 'OPEN'
        && event.toStatus == 'ASSIGNED'
        && event.createdAt == request.time;
    }

    function isAcceptanceTransition(requestId, professionalId) {
      let requestPath = /databases/$(database)/documents/serviceRequests/$(requestId);
      let before = get(requestPath).data;
      let after = getAfter(requestPath).data;
      let refusalPath = /databases/$(database)/documents/serviceRequests/$(requestId)/rounds/$(before.currentRoundId)/refusals/$(professionalId);

      return request.auth != null
        && request.auth.uid == professionalId
        && before.status == 'OPEN'
        && before.assignedProfessionalId == null
        && before.currentAssignmentId == null
        && after.status == 'ASSIGNED'
        && after.assignedProfessionalId == professionalId
        && after.currentAssignmentId is string
        && after.round == before.round
        && after.currentRoundId == before.currentRoundId
        && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'assignedProfessionalId', 'currentAssignmentId', 'updatedAt'
        ])
        && request.time < before.acceptUntil
        && professionalMatchesRequest(before, professionalId)
        && hasAvailableServiceSlot(before, professionalId)
        && !exists(refusalPath)
        && hasValidAcceptanceDocuments(
          requestId,
          professionalId,
          before,
          after
        );
    }

    function hasValidCancellationDocuments(requestId, professionalId, before, after) {
      let assignmentPath = /databases/$(database)/documents/serviceRequests/$(requestId)/assignments/$(before.currentAssignmentId);
      let oldAssignment = get(assignmentPath).data;
      let newAssignment = getAfter(assignmentPath).data;
      let reservationPath = /databases/$(database)/documents/professionalReservations/$(professionalId)/slots/$(oldAssignment.reservationId);
      let nextRoundPath = /databases/$(database)/documents/serviceRequests/$(requestId)/rounds/$(after.currentRoundId);
      let nextRound = getAfter(nextRoundPath).data;
      let eventPath = /databases/$(database)/documents/serviceRequests/$(requestId)/events/$(newAssignment.endedEventId);
      let event = getAfter(eventPath).data;

      return exists(assignmentPath)
        && exists(reservationPath)
        && !exists(nextRoundPath)
        && !exists(eventPath)
        && existsAfter(assignmentPath)
        && !existsAfter(reservationPath)
        && existsAfter(nextRoundPath)
        && existsAfter(eventPath)
        && oldAssignment.status == 'ACTIVE'
        && oldAssignment.professionalId == professionalId
        && oldAssignment.requestId == requestId
        && newAssignment.diff(oldAssignment).affectedKeys().hasOnly([
          'status', 'endedAt', 'endReason', 'endedEventId'
        ])
        && newAssignment.status == 'CANCELLED'
        && newAssignment.endedAt == request.time
        && newAssignment.endReason == 'PROFESSIONAL_CANCELLATION'
        && newAssignment.endedEventId is string
        && nextRound.keys().hasAll([
          'roundId', 'requestId', 'round', 'status', 'reason',
          'excludedProfessionalIds', 'previousAssignmentId', 'openedAt',
          'closedAt', 'closedReason', 'updatedAt'
        ])
        && nextRound.keys().hasOnly([
          'roundId', 'requestId', 'round', 'status', 'reason',
          'excludedProfessionalIds', 'previousAssignmentId', 'openedAt',
          'closedAt', 'closedReason', 'updatedAt'
        ])
        && nextRound.roundId == after.currentRoundId
        && nextRound.requestId == requestId
        && nextRound.round == before.round + 1
        && nextRound.status == 'OPEN'
        && nextRound.reason == 'PROFESSIONAL_CANCELLATION'
        && nextRound.excludedProfessionalIds == [professionalId]
        && nextRound.previousAssignmentId == before.currentAssignmentId
        && nextRound.openedAt == request.time
        && nextRound.closedAt == null
        && nextRound.closedReason == null
        && nextRound.updatedAt == request.time
        && event.keys().hasAll([
          'eventId', 'entityType', 'entityId', 'requestId', 'type',
          'reasonCode', 'actorId', 'actorRole', 'round', 'targetRound',
          'assignmentId', 'fromStatus', 'toStatus', 'createdAt'
        ])
        && event.keys().hasOnly([
          'eventId', 'entityType', 'entityId', 'requestId', 'type',
          'reasonCode', 'actorId', 'actorRole', 'round', 'targetRound',
          'assignmentId', 'fromStatus', 'toStatus', 'createdAt'
        ])
        && event.eventId == newAssignment.endedEventId
        && event.entityType == 'SERVICE_REQUEST'
        && event.entityId == requestId
        && event.requestId == requestId
        && event.type == 'PROFESSIONAL_CANCELLED_AND_REOPENED'
        && event.reasonCode == 'PROFESSIONAL_CANCELLATION'
        && event.actorId == professionalId
        && event.actorRole == 'PROFESSIONAL'
        && event.round == before.round
        && event.targetRound == before.round + 1
        && event.assignmentId == before.currentAssignmentId
        && event.fromStatus == 'ASSIGNED'
        && event.toStatus == 'OPEN'
        && event.createdAt == request.time;
    }

    function isCancellationTransition(requestId, professionalId) {
      let requestPath = /databases/$(database)/documents/serviceRequests/$(requestId);
      let before = get(requestPath).data;
      let after = getAfter(requestPath).data;

      return request.auth != null
        && request.auth.uid == professionalId
        && before.status == 'ASSIGNED'
        && before.assignedProfessionalId == professionalId
        && before.currentAssignmentId is string
        && request.time < before.periodStartAt
        && after.status == 'OPEN'
        && after.round == before.round + 1
        && after.currentRoundId is string
        && after.currentRoundId != before.currentRoundId
        && after.assignedProfessionalId == null
        && after.currentAssignmentId == null
        && after.reopenReason == 'PROFESSIONAL_CANCELLATION'
        && after.excludedProfessionalIds == [professionalId]
        && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'round', 'currentRoundId', 'assignedProfessionalId',
          'currentAssignmentId', 'reopenReason', 'excludedProfessionalIds',
          'updatedAt'
        ])
        && hasValidCancellationDocuments(
          requestId,
          professionalId,
          before,
          after
        );
    }

    function isRefusalCreate(requestId, roundId, professionalId) {
      let requestPath = /databases/$(database)/documents/serviceRequests/$(requestId);
      let summary = get(requestPath).data;
      let refusalPath = /databases/$(database)/documents/serviceRequests/$(requestId)/rounds/$(roundId)/refusals/$(professionalId);
      let refusal = getAfter(refusalPath).data;
      let eventPath = /databases/$(database)/documents/serviceRequests/$(requestId)/events/$(refusal.eventId);
      let event = getAfter(eventPath).data;

      return request.auth != null
        && request.auth.uid == professionalId
        && summary.status == 'OPEN'
        && summary.currentRoundId == roundId
        && request.time < summary.acceptUntil
        && professionalMatchesRequest(summary, professionalId)
        && !exists(refusalPath)
        && !exists(eventPath)
        && get(
          /databases/$(database)/documents/serviceRequests/$(requestId)/rounds/$(roundId)
        ).data.status == 'OPEN'
        && refusal.keys().hasAll([
          'requestId', 'roundId', 'round', 'professionalId', 'decision',
          'eventId', 'createdAt'
        ])
        && refusal.keys().hasOnly([
          'requestId', 'roundId', 'round', 'professionalId', 'decision',
          'eventId', 'createdAt'
        ])
        && refusal.requestId == requestId
        && refusal.roundId == roundId
        && refusal.round == summary.round
        && refusal.professionalId == professionalId
        && refusal.decision == 'REFUSED'
        && refusal.createdAt == request.time
        && event.keys().hasAll([
          'eventId', 'entityType', 'entityId', 'requestId', 'type',
          'reasonCode', 'actorId', 'actorRole', 'round', 'assignmentId',
          'fromStatus', 'toStatus', 'createdAt'
        ])
        && event.keys().hasOnly([
          'eventId', 'entityType', 'entityId', 'requestId', 'type',
          'reasonCode', 'actorId', 'actorRole', 'round', 'assignmentId',
          'fromStatus', 'toStatus', 'createdAt'
        ])
        && event.eventId == refusal.eventId
        && event.entityType == 'SERVICE_REQUEST'
        && event.entityId == requestId
        && event.requestId == requestId
        && event.type == 'PROFESSIONAL_REFUSED'
        && event.reasonCode == 'PROFESSIONAL_REFUSAL'
        && event.actorId == professionalId
        && event.actorRole == 'PROFESSIONAL'
        && event.round == summary.round
        && event.assignmentId == null
        && event.fromStatus == 'OPEN'
        && event.toStatus == 'OPEN'
        && event.createdAt == request.time;
    }

    function canReadServiceRequest(requestId) {
      let summary = get(
        /databases/$(database)/documents/serviceRequests/$(requestId)
      ).data;

      return request.auth != null
        && (request.auth.uid == summary.clientId
          || request.auth.uid == summary.assignedProfessionalId
          || isActiveAdmin()
          || hasApprovedOperationalProfile(request.auth.uid));
    }

    function hasValidLegalAcceptances() {
      let acceptances = request.resource.data.legalAcceptances;

      return acceptances is map
        && acceptances.keys().hasOnly(['termsOfUse', 'privacyPolicy'])
        && acceptances.termsOfUse is map
        && acceptances.termsOfUse.keys().hasOnly(['version', 'acceptedAt'])
        && acceptances.termsOfUse.version == '1.0.0'
        && acceptances.termsOfUse.acceptedAt == request.time
        && acceptances.privacyPolicy is map
        && acceptances.privacyPolicy.keys().hasOnly(['version', 'acceptedAt'])
        && acceptances.privacyPolicy.version == '1.0.0'
        && acceptances.privacyPolicy.acceptedAt == request.time;
    }

    function hasValidRoleConfiguration() {
      return request.resource.data.roles is list
        && request.resource.data.roles.size() >= 1
        && request.resource.data.roles.size() <= 2
        && request.resource.data.roles.hasOnly(['client', 'professional'])
        && (request.resource.data.roles.size() == 1
          || ('client' in request.resource.data.roles
            && 'professional' in request.resource.data.roles))
        && request.resource.data.activeMode is string
        && request.resource.data.activeMode in request.resource.data.roles;
    }

    function hasNoConfiguredRoles() {
      let roles = resource.data.get('roles', []);
      let activeMode = resource.data.get('activeMode', null);

      return roles is list
        && roles.size() == 0
        && activeMode == null;
    }

    function hasRoleEnablementGrant(userId, role) {
      return exists(
        /databases/$(database)/documents/roleEnablementGrants/$(userId)/roles/$(role)
      );
    }

    function isGrantedRoleExpansion(userId) {
      let currentRoles = resource.data.get('roles', []);
      let nextRoles = request.resource.data.roles;

      return currentRoles is list
        && currentRoles.size() >= 1
        && nextRoles.size() == currentRoles.size() + 1
        && nextRoles.hasAll(currentRoles)
        && (('client' in currentRoles)
          || !('client' in nextRoles)
          || hasRoleEnablementGrant(userId, 'client'))
        && (('professional' in currentRoles)
          || !('professional' in nextRoles)
          || hasRoleEnablementGrant(userId, 'professional'));
    }

    function hasProfessionalRole(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.roles is list
        && 'professional' in get(
          /databases/$(database)/documents/users/$(userId)
        ).data.roles;
    }

    function hasClientRole(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.roles is list
        && 'client' in get(
          /databases/$(database)/documents/users/$(userId)
        ).data.roles;
    }

    function hasValidProfessionalProfileSummary(userId) {
      let currentStatus = resource.data.get('professionalProfileStatus', 'not-started');
      let nextStatus = request.resource.data.professionalProfileStatus;
      let profilePath = /databases/$(database)/documents/professionalProfiles/$(userId);

      return nextStatus in ['not-started', 'incomplete', 'complete']
        && (nextStatus == currentStatus
          || ('professional' in request.resource.data.roles
            && existsAfter(profilePath)
            && ((nextStatus == 'incomplete'
                && getAfter(profilePath).data.status == 'DRAFT')
              || (nextStatus == 'complete'
                && getAfter(profilePath).data.status in ['PUBLISHED', 'PAUSED']))));
    }

    function hasValidClientAvatar(image, userId) {
      return image.keys().size() == 7
        && image.keys().hasOnly([
          'provider', 'ownerId', 'purpose', 'url', 'providerId',
          'createdAt', 'updatedAt'
        ])
        && image.provider in ['IMAGEKIT', 'BACKEND']
        && image.ownerId == userId
        && image.purpose == 'CLIENT_AVATAR'
        && image.url.matches('^https://.+')
        && image.url.size() <= 2048
        && image.providerId.matches('^.{1,300}$')
        && image.createdAt > 0
        && image.updatedAt >= image.createdAt;
    }

    function hasValidClientProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'phone', 'profileImage', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'phone', 'profileImage', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.phone is string
        && (data.phone == '' || data.phone.matches('^[0-9]{10,11}$'))
        && (data.profileImage == null
          || hasValidClientAvatar(data.profileImage, userId))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function hasValidProfessionalProfileFields() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'ownerId',
          'publicName',
          'headline',
          'categoryIds',
          'specialtyIds',
          'experienceYears',
          'baseLocation',
          'serviceMode',
          'serviceRadiusKm',
          'selectedCities',
          'availability',
          'contactVisibility',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'publicName',
          'headline',
          'bio',
          'categoryIds',
          'specialtyIds',
          'experienceYears',
          'baseLocation',
          'serviceMode',
          'serviceRadiusKm',
          'selectedCities',
          'selectedCityIbgeCodes',
          'availability',
          'contactVisibility',
          'phone',
          'profileImage',
          'portfolioImages',
          'status',
          'createdAt',
          'updatedAt',
          'rating',
          'reviewCount',
          'completedJobsCount'
        ])
        && data.ownerId is string
        && data.publicName is string
        && data.publicName.size() <= 120
        && data.headline is string
        && data.headline.size() <= 120
        && (!('bio' in data)
          || (data.bio is string && data.bio.size() <= 1200))
        && data.categoryIds is list
        && data.categoryIds.size() <= 5
        && data.specialtyIds is list
        && data.specialtyIds.size() <= 10
        && (data.experienceYears == null
          || (data.experienceYears is int
            && data.experienceYears >= 0
            && data.experienceYears <= 80))
        && hasValidProfessionalBaseLocation(data.baseLocation)
        && (data.serviceMode == null
          || data.serviceMode in [
            'CITY_ONLY', 'RADIUS', 'SELECTED_CITIES'
          ])
        && ((data.serviceMode == 'RADIUS'
            && (data.serviceRadiusKm == null
              || data.serviceRadiusKm in [5, 10, 20, 30, 50]))
          || (data.serviceMode != 'RADIUS'
            && data.serviceRadiusKm == null))
        && hasValidSelectedCities(
          data.selectedCities,
          data.get('selectedCityIbgeCodes', null)
        )
        && ((data.serviceMode == 'SELECTED_CITIES')
          || data.selectedCities.size() == 0)
        && data.availability in ['AVAILABLE', 'LIMITED', 'UNAVAILABLE']
        && data.contactVisibility in ['PUBLIC', 'PRIVATE']
        && ((data.contactVisibility == 'PRIVATE' && !('phone' in data))
          || (data.contactVisibility == 'PUBLIC'
            && data.phone is string
            && data.phone.matches('^[0-9]{10,11}$')))
        && hasValidProfessionalImages(
          data.ownerId,
          data.get('profileImage', null),
          data.get('portfolioImages', [])
        )
        && data.status in ['DRAFT', 'PUBLISHED', 'PAUSED', 'SUSPENDED']
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function hasValidProfessionalProfileUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();

      return (!changed.hasAny(['publicName'])
          || (data.publicName is string && data.publicName.size() <= 120))
        && (!changed.hasAny(['headline'])
          || (data.headline is string && data.headline.size() <= 120))
        && (!changed.hasAny(['bio'])
          || (!('bio' in data)
            || (data.bio is string && data.bio.size() <= 1200)))
        && (!changed.hasAny(['categoryIds'])
          || (data.categoryIds is list && data.categoryIds.size() <= 5))
        && (!changed.hasAny(['specialtyIds'])
          || (data.specialtyIds is list && data.specialtyIds.size() <= 10))
        && (!changed.hasAny(['experienceYears'])
          || data.experienceYears == null
          || (data.experienceYears is int
            && data.experienceYears >= 0
            && data.experienceYears <= 80))
        && (!changed.hasAny(['baseLocation'])
          || hasValidProfessionalBaseLocation(data.baseLocation))
        && (!changed.hasAny(['serviceMode', 'serviceRadiusKm'])
          || ((data.serviceMode == null
              || data.serviceMode in [
                'CITY_ONLY', 'RADIUS', 'SELECTED_CITIES'
              ])
            && ((data.serviceMode == 'RADIUS'
                && (data.serviceRadiusKm == null
                  || data.serviceRadiusKm in [5, 10, 20, 30, 50]))
              || (data.serviceMode != 'RADIUS'
                && data.serviceRadiusKm == null))
            && ((data.serviceMode == 'SELECTED_CITIES')
              || data.selectedCities.size() == 0)))
        && (!changed.hasAny(['selectedCities', 'selectedCityIbgeCodes'])
          || (hasValidSelectedCities(
              data.selectedCities,
              data.get('selectedCityIbgeCodes', null)
            )
            && ((data.serviceMode == 'SELECTED_CITIES')
              || data.selectedCities.size() == 0)))
        && (!changed.hasAny(['availability'])
          || data.availability in ['AVAILABLE', 'LIMITED', 'UNAVAILABLE'])
        && (!changed.hasAny(['contactVisibility', 'phone'])
          || (data.contactVisibility in ['PUBLIC', 'PRIVATE']
            && ((data.contactVisibility == 'PRIVATE' && !('phone' in data))
              || (data.contactVisibility == 'PUBLIC'
                && data.phone is string
                && data.phone.matches('^[0-9]{10,11}$')))))
        && (!changed.hasAny(['profileImage', 'portfolioImages'])
          || hasValidProfessionalImages(
            data.ownerId,
            data.get('profileImage', null),
            data.get('portfolioImages', [])
          ))
        && (!changed.hasAny(['status'])
          || data.status in ['DRAFT', 'PUBLISHED', 'PAUSED'])
        && data.updatedAt == request.time;
    }

    function isBrazilianStateCode(stateCode) {
      return stateCode in [
        'AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO',
        'MA', 'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI',
        'RJ', 'RN', 'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO'
      ];
    }

    function ibgeCodeMatchesState(stateCode, ibgeCode) {
      return (stateCode + ':' + ibgeCode).matches(
        '^(AC:12|AL:27|AP:16|AM:13|BA:29|CE:23|DF:53|ES:32|GO:52|MA:21|MT:51|MS:50|MG:31|PA:15|PB:25|PR:41|PE:26|PI:22|RJ:33|RN:24|RS:43|RO:11|RR:14|SC:42|SP:35|SE:28|TO:17)[0-9]{5}$'
      );
    }

    function hasValidProfessionalBaseLocation(baseLocation) {
      return baseLocation is map
        && baseLocation.keys().hasAll(['city', 'stateCode', 'ibgeCode'])
        && baseLocation.keys().hasOnly(['city', 'stateCode', 'ibgeCode'])
        && baseLocation.city is string
        && baseLocation.city.size() <= 120
        && baseLocation.stateCode is string
        && (baseLocation.stateCode == ''
          || isBrazilianStateCode(baseLocation.stateCode))
        && baseLocation.ibgeCode is string
        && (baseLocation.ibgeCode == ''
          || baseLocation.ibgeCode.matches('^[0-9]{7}$'))
        && (baseLocation.stateCode == ''
          || baseLocation.ibgeCode == ''
          || ibgeCodeMatchesState(
            baseLocation.stateCode,
            baseLocation.ibgeCode
          ));
    }

    function hasCompleteProfessionalLocation(location) {
      return hasValidProfessionalBaseLocation(location)
        && location.city.size() >= 1
        && location.stateCode != ''
        && location.ibgeCode != '';
    }

    function hasValidSelectedCityCodeAt(codes, index) {
      return codes.size() <= index
        || (codes[index] is string
          && codes[index].matches('^[0-9]{7}$'));
    }

    function hasValidSelectedCities(cities, codes) {
      return cities is list
        && cities.size() <= 10
        && ((cities.size() == 0
            && (codes == null || codes.size() == 0))
          || (codes == null
            && cities.size() == cities.toSet().size())
          || (codes is list
            && codes.size() == cities.size()
            && codes.size() == codes.toSet().size()
            && hasValidSelectedCityCodeAt(codes, 0)
            && hasValidSelectedCityCodeAt(codes, 1)
            && hasValidSelectedCityCodeAt(codes, 2)
            && hasValidSelectedCityCodeAt(codes, 3)
            && hasValidSelectedCityCodeAt(codes, 4)
            && hasValidSelectedCityCodeAt(codes, 5)
            && hasValidSelectedCityCodeAt(codes, 6)
            && hasValidSelectedCityCodeAt(codes, 7)
            && hasValidSelectedCityCodeAt(codes, 8)
            && hasValidSelectedCityCodeAt(codes, 9)));
    }

    function hasValidProfessionalImage(image, ownerId, purpose) {
      return image.keys().size() == 9
        && image.keys().hasOnly([
          'provider', 'ownerId', 'purpose', 'url', 'providerId',
          'createdAt', 'updatedAt', 'order', 'altText'
        ])
        && image.provider in ['IMAGEKIT', 'BACKEND']
        && image.ownerId == ownerId
        && image.purpose == purpose
        && image.url.matches('^https://.+')
        && image.url.size() <= 2048
        && image.providerId.matches('^.{1,300}$')
        && image.altText.matches('^.{0,240}$')
        && image.createdAt > 0
        && image.updatedAt >= image.createdAt;
    }

    function hasValidProfessionalImageAt(images, index, ownerId) {
      return images.size() <= index
        || (hasValidProfessionalImage(
            images[index], ownerId, 'PROFESSIONAL_PORTFOLIO'
          )
          && images[index].order == index);
    }

    function hasAccessibleProfessionalImageAt(images, index) {
      return images.size() <= index
        || images[index].altText.size() >= 1;
    }

    function hasValidProfessionalImages(ownerId, profileImage, portfolioImages) {
      return (profileImage == null
          || (hasValidProfessionalImage(
              profileImage, ownerId, 'PROFESSIONAL_AVATAR'
            )
            && profileImage.order == 0))
        && portfolioImages is list
        && portfolioImages.size() <= 3
        && hasValidProfessionalImageAt(portfolioImages, 0, ownerId)
        && hasValidProfessionalImageAt(portfolioImages, 1, ownerId)
        && hasValidProfessionalImageAt(portfolioImages, 2, ownerId);
    }

    function hasAccessibleProfessionalImages(profileImage, portfolioImages) {
      return (profileImage == null || profileImage.altText.size() >= 1)
        && hasAccessibleProfessionalImageAt(portfolioImages, 0)
        && hasAccessibleProfessionalImageAt(portfolioImages, 1)
        && hasAccessibleProfessionalImageAt(portfolioImages, 2);
    }

    function isPublishableProfessionalProfile() {
      let data = request.resource.data;

      return data.publicName.size() >= 2
        && hasCompleteProfessionalLocation(data.baseLocation)
        && data.categoryIds.size() >= 1
        && data.specialtyIds.size() >= 1
        && data.serviceMode in [
          'CITY_ONLY', 'RADIUS', 'SELECTED_CITIES'
        ]
        && (data.serviceMode != 'RADIUS'
          || data.serviceRadiusKm in [5, 10, 20, 30, 50])
        && (data.serviceMode != 'SELECTED_CITIES'
          || data.selectedCities.size() >= 1)
        && hasAccessibleProfessionalImages(
          data.get('profileImage', null),
          data.get('portfolioImages', [])
        );
    }

    function hasValidProfessionalPrivateProfile(data, userId) {
      let location = data.privateLocation;

      return data.keys().hasAll([
          'ownerId', 'phone', 'privateLocation', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'phone', 'privateLocation', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.phone is string
        && (data.phone == '' || data.phone.matches('^[0-9]{10,11}$'))
        && location is map
        && location.keys().hasAll(['postalCode'])
        && location.keys().hasOnly(['postalCode', 'neighborhood'])
        && location.postalCode is string
        && (location.postalCode == ''
          || location.postalCode.matches('^[0-9]{8}$'))
        && (!('neighborhood' in location)
          || (location.neighborhood is string
            && location.neighborhood.size() <= 120))
        && data.updatedAt == request.time;
    }

    function professionalReviewFieldsChanged(before, after) {
      return after.diff(before).affectedKeys().hasAny([
        'publicName', 'headline', 'bio', 'categoryIds', 'specialtyIds',
        'experienceYears', 'baseLocation', 'serviceMode', 'serviceRadiusKm',
        'selectedCities', 'selectedCityIbgeCodes', 'profileImage',
        'portfolioImages'
      ]);
    }

    function hasValidOperationalReview(data, professionalId) {
      return data.keys().hasAll([
          'schemaVersion', 'professionalId', 'reviewStatus', 'active',
          'profileVersion', 'submittedVersion', 'approvedVersion', 'revision',
          'lastEventId', 'professionalFeedback', 'approvedCategoryIds',
          'approvedSpecialtyIds', 'approvedBaseCityIbgeCode',
          'approvedSelectedCityIbgeCodes', 'eligibleCityIbgeCodes', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'professionalId', 'reviewStatus', 'active',
          'profileVersion', 'submittedVersion', 'approvedVersion', 'revision',
          'lastEventId', 'professionalFeedback', 'approvedCategoryIds',
          'approvedSpecialtyIds', 'approvedBaseCityIbgeCode',
          'approvedSelectedCityIbgeCodes', 'eligibleCityIbgeCodes', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.professionalId == professionalId
        && data.reviewStatus in [
          'DRAFT', 'UNDER_REVIEW', 'CHANGES_REQUESTED', 'APPROVED',
          'REJECTED', 'SUSPENDED'
        ]
        && data.active is bool
        && data.profileVersion is int
        && data.profileVersion >= 1
        && (data.submittedVersion == null || data.submittedVersion is int)
        && (data.approvedVersion == null || data.approvedVersion is int)
        && data.revision is int
        && data.revision >= 1
        && data.lastEventId is string
        && data.lastEventId == 'review-' + string(data.revision)
        && (data.professionalFeedback == null
          || (data.professionalFeedback is string
            && data.professionalFeedback.size() <= 1200))
        && data.approvedCategoryIds is list
        && data.approvedSpecialtyIds is list
        && data.approvedBaseCityIbgeCode is string
        && data.approvedSelectedCityIbgeCodes is list
        && data.eligibleCityIbgeCodes is list
        && data.updatedAt == request.time;
    }

    function hasValidReviewEvent(professionalId, eventId) {
      let eventPath = /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)/events/$(eventId);
      let event = getAfter(eventPath).data;

      return !exists(eventPath)
        && existsAfter(eventPath)
        && event.keys().hasAll([
          'eventId', 'entityType', 'entityId', 'professionalId', 'actorId',
          'actorRole', 'action', 'reasonCode', 'fromStatus', 'toStatus',
          'profileVersion', 'reviewedVersion', 'reason', 'createdAt'
        ])
        && event.keys().hasOnly([
          'eventId', 'entityType', 'entityId', 'professionalId', 'actorId',
          'actorRole', 'action', 'reasonCode', 'fromStatus', 'toStatus',
          'profileVersion', 'reviewedVersion', 'reason', 'createdAt'
        ])
        && event.eventId == eventId
        && event.entityType == 'PROFESSIONAL'
        && event.entityId == professionalId
        && event.professionalId == professionalId
        && event.actorId == request.auth.uid
        && ((event.action in ['PROFILE_UPDATED', 'REANALYSIS_REQUIRED']
              && event.reasonCode == 'PROFILE_DATA_CHANGED')
          || (event.action == 'PROFILE_SUBMITTED'
              && event.reasonCode == 'PROFESSIONAL_SUBMISSION')
          || (event.action == 'PROFILE_RESUBMITTED'
              && event.reasonCode == 'PROFESSIONAL_RESUBMISSION')
          || (event.action in ['APPROVED', 'CHANGES_REQUESTED', 'REJECTED']
              && event.reasonCode == 'ADMIN_DECISION')
          || (event.action == 'SUSPENDED'
              && event.reasonCode == 'ADMIN_SUSPENSION')
          || (event.action in ['ACTIVATED', 'DEACTIVATED']
              && event.reasonCode == 'ADMIN_ACTIVATION_CHANGE'))
        && event.createdAt == request.time;
    }

    function isInitialProfessionalReview(professionalId) {
      let profilePath = /databases/$(database)/documents/professionalProfiles/$(professionalId);
      let operationalPath = /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId);
      let profile = getAfter(profilePath).data;
      let operational = getAfter(operationalPath).data;
      let submitted = profile.status == 'PUBLISHED';

      return isDocumentOwner(professionalId)
        && existsAfter(profilePath)
        && !exists(operationalPath)
        && existsAfter(operationalPath)
        && hasValidOperationalReview(operational, professionalId)
        && operational.reviewStatus == (submitted ? 'UNDER_REVIEW' : 'DRAFT')
        && operational.active == false
        && operational.profileVersion == 1
        && ((submitted && operational.submittedVersion == 1)
          || (!submitted && operational.submittedVersion == null))
        && operational.approvedVersion == null
        && operational.revision == 1
        && operational.professionalFeedback == null
        && operational.approvedCategoryIds.size() == 0
        && operational.approvedSpecialtyIds.size() == 0
        && operational.approvedBaseCityIbgeCode == ''
        && operational.approvedSelectedCityIbgeCodes.size() == 0
        && operational.eligibleCityIbgeCodes.size() == 0
        && hasValidReviewEvent(professionalId, operational.lastEventId)
        && getAfter(
          /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)/events/$(operational.lastEventId)
        ).data.actorRole == 'PROFESSIONAL'
        && getAfter(
          /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)/events/$(operational.lastEventId)
        ).data.action == (submitted ? 'PROFILE_SUBMITTED' : 'PROFILE_UPDATED')
        && getAfter(
          /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)/events/$(operational.lastEventId)
        ).data.fromStatus == 'DRAFT'
        && getAfter(
          /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)/events/$(operational.lastEventId)
        ).data.toStatus == operational.reviewStatus
        && getAfter(
          /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)/events/$(operational.lastEventId)
        ).data.profileVersion == 1
        && getAfter(
          /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)/events/$(operational.lastEventId)
        ).data.reviewedVersion == null
        && getAfter(
          /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)/events/$(operational.lastEventId)
        ).data.reason == null;
    }

    function hasExpectedProfessionalReviewStatus(before, after, profile, relevant) {
      return ((before.reviewStatus in ['REJECTED', 'SUSPENDED'])
          && after.reviewStatus == before.reviewStatus)
        || (before.reviewStatus == 'APPROVED' && relevant
          && after.reviewStatus == 'UNDER_REVIEW')
        || (before.reviewStatus == 'UNDER_REVIEW' && relevant
          && after.reviewStatus == 'UNDER_REVIEW')
        || (before.reviewStatus in ['DRAFT', 'CHANGES_REQUESTED']
          && profile.status == 'PUBLISHED'
          && after.reviewStatus == 'UNDER_REVIEW')
        || (relevant
          && before.reviewStatus in ['DRAFT', 'CHANGES_REQUESTED']
          && profile.status != 'PUBLISHED'
          && after.reviewStatus == before.reviewStatus);
    }

    function hasValidProfessionalReviewAction(before, after, relevant) {
      let eventPath = /databases/$(database)/documents/professionalOperationalProfiles/$(after.professionalId)/events/$(after.lastEventId);
      let action = getAfter(eventPath).data.action;

      return (before.reviewStatus == 'APPROVED' && relevant
          && action == 'REANALYSIS_REQUIRED')
        || (before.reviewStatus == 'UNDER_REVIEW' && relevant
          && action == 'REANALYSIS_REQUIRED')
        || (before.reviewStatus == 'DRAFT'
          && after.reviewStatus == 'UNDER_REVIEW'
          && action == 'PROFILE_SUBMITTED')
        || (before.reviewStatus == 'CHANGES_REQUESTED'
          && after.reviewStatus == 'UNDER_REVIEW'
          && action == 'PROFILE_RESUBMITTED')
        || (action == 'PROFILE_UPDATED');
    }

    function isProfessionalReviewTransition(professionalId) {
      let profilePath = /databases/$(database)/documents/professionalProfiles/$(professionalId);
      let operationalPath = /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId);
      let profileBefore = get(profilePath).data;
      let profileAfter = getAfter(profilePath).data;
      let before = get(operationalPath).data;
      let after = getAfter(operationalPath).data;
      let relevant = professionalReviewFieldsChanged(profileBefore, profileAfter);
      let nextVersion = before.profileVersion + (relevant ? 1 : 0);
      let eventPath = /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)/events/$(after.lastEventId);
      let event = getAfter(eventPath).data;

      return isDocumentOwner(professionalId)
        && exists(profilePath)
        && existsAfter(profilePath)
        && exists(operationalPath)
        && existsAfter(operationalPath)
        && hasValidOperationalReview(after, professionalId)
        && (relevant
          || (before.reviewStatus in ['DRAFT', 'CHANGES_REQUESTED']
            && profileAfter.status == 'PUBLISHED'))
        && hasExpectedProfessionalReviewStatus(
          before, after, profileAfter, relevant
        )
        && after.diff(before).affectedKeys().hasOnly([
          'schemaVersion', 'reviewStatus', 'profileVersion',
          'submittedVersion', 'revision', 'lastEventId',
          'professionalFeedback', 'updatedAt'
        ])
        && after.professionalId == before.professionalId
        && after.active == before.active
        && after.profileVersion == nextVersion
        && after.approvedVersion == before.approvedVersion
        && after.revision == before.get('revision', 0) + 1
        && ((after.reviewStatus == 'UNDER_REVIEW'
            && after.submittedVersion == nextVersion)
          || (after.reviewStatus != 'UNDER_REVIEW'
            && after.submittedVersion == null))
        && ((after.reviewStatus == 'UNDER_REVIEW'
            && after.professionalFeedback == null)
          || (after.reviewStatus != 'UNDER_REVIEW'
            && after.professionalFeedback
              == before.get('professionalFeedback', null)))
        && after.approvedCategoryIds == before.approvedCategoryIds
        && after.approvedSpecialtyIds == before.approvedSpecialtyIds
        && after.approvedBaseCityIbgeCode == before.approvedBaseCityIbgeCode
        && after.approvedSelectedCityIbgeCodes
          == before.approvedSelectedCityIbgeCodes
        && after.eligibleCityIbgeCodes == before.eligibleCityIbgeCodes
        && hasValidProfessionalReviewAction(before, after, relevant)
        && hasValidReviewEvent(professionalId, after.lastEventId)
        && event.actorRole == 'PROFESSIONAL'
        && event.fromStatus == before.reviewStatus
        && event.toStatus == after.reviewStatus
        && event.profileVersion == nextVersion
        && event.reviewedVersion == null
        && event.reason == null;
    }

    function approvedSnapshotMatchesProfile(after, profile) {
      return after.approvedCategoryIds == profile.categoryIds
        && after.approvedSpecialtyIds == profile.specialtyIds
        && after.approvedBaseCityIbgeCode == profile.baseLocation.ibgeCode
        && after.approvedSelectedCityIbgeCodes
          == profile.get('selectedCityIbgeCodes', [])
        && after.eligibleCityIbgeCodes.hasAll(
          [profile.baseLocation.ibgeCode]
        )
        && after.eligibleCityIbgeCodes.hasAll(
          profile.get('selectedCityIbgeCodes', [])
        );
    }

    function hasValidInternalReviewEvent(professionalId, eventId, action, reviewedVersion) {
      let internalPath = /databases/$(database)/documents/professionalReviewInternal/$(professionalId)/events/$(eventId);
      let internal = getAfter(internalPath).data;

      return !exists(internalPath)
        && existsAfter(internalPath)
        && internal.keys().hasAll([
          'eventId', 'professionalId', 'actorId', 'action',
          'reviewedVersion', 'note', 'createdAt'
        ])
        && internal.keys().hasOnly([
          'eventId', 'professionalId', 'actorId', 'action',
          'reviewedVersion', 'note', 'createdAt'
        ])
        && internal.eventId == eventId
        && internal.professionalId == professionalId
        && internal.actorId == request.auth.uid
        && internal.action == action
        && internal.reviewedVersion == reviewedVersion
        && internal.note is string
        && internal.note.size() <= 4000
        && internal.createdAt == request.time;
    }

    function isReviewApproval(before, after) {
      return before.reviewStatus == 'UNDER_REVIEW'
        && after.reviewStatus == 'APPROVED';
    }

    function isReviewChangesRequest(before, after) {
      return after.reviewStatus == 'CHANGES_REQUESTED'
        && (before.reviewStatus == 'UNDER_REVIEW'
          || before.reviewStatus in ['REJECTED', 'SUSPENDED']);
    }

    function isReviewRejection(before, after) {
      return before.reviewStatus == 'UNDER_REVIEW'
        && after.reviewStatus == 'REJECTED';
    }

    function isReviewSuspension(before, after) {
      return before.reviewStatus == 'APPROVED'
        && after.reviewStatus == 'SUSPENDED';
    }

    function isReviewActiveChange(before, after) {
      return after.reviewStatus == before.reviewStatus
        && after.active != before.active;
    }

    function isReviewDecision(before, after) {
      return isReviewApproval(before, after)
        || isReviewChangesRequest(before, after)
        || isReviewRejection(before, after);
    }

    function isAdministrativeReviewTransition(professionalId) {
      let profilePath = /databases/$(database)/documents/professionalProfiles/$(professionalId);
      let operationalPath = /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId);
      let profile = get(profilePath).data;
      let before = get(operationalPath).data;
      let after = getAfter(operationalPath).data;
      let eventPath = /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)/events/$(after.lastEventId);
      let event = getAfter(eventPath).data;
      let decision = isReviewDecision(before, after);
      let suspending = isReviewSuspension(before, after);
      let activeChange = isReviewActiveChange(before, after);

      return isActiveAdmin()
        && exists(profilePath)
        && exists(operationalPath)
        && existsAfter(operationalPath)
        && hasValidOperationalReview(after, professionalId)
        && after.professionalId == before.professionalId
        && after.profileVersion == before.profileVersion
        && after.revision == before.get('revision', 0) + 1
        && getAfter(profilePath).data == profile
        && (decision || suspending || activeChange)
        && after.diff(before).affectedKeys().hasOnly([
          'schemaVersion', 'reviewStatus', 'active', 'submittedVersion', 'approvedVersion',
          'revision', 'lastEventId', 'professionalFeedback',
          'approvedCategoryIds', 'approvedSpecialtyIds',
          'approvedBaseCityIbgeCode', 'approvedSelectedCityIbgeCodes',
          'eligibleCityIbgeCodes', 'updatedAt'
        ])
        && (!decision
          || before.reviewStatus != 'UNDER_REVIEW'
          || before.submittedVersion == before.profileVersion)
        && (!isReviewApproval(before, after) || (
          after.approvedVersion == before.profileVersion
          && after.submittedVersion == before.profileVersion
          && after.active == before.active
          && approvedSnapshotMatchesProfile(after, profile)
        ))
        && (!(isReviewChangesRequest(before, after)
            || isReviewRejection(before, after)) || (
          after.active == false
          && after.submittedVersion == null
          && after.approvedVersion == null
          && after.approvedCategoryIds.size() == 0
          && after.approvedSpecialtyIds.size() == 0
          && after.approvedBaseCityIbgeCode == ''
          && after.approvedSelectedCityIbgeCodes.size() == 0
          && after.eligibleCityIbgeCodes.size() == 0
          && after.professionalFeedback is string
          && after.professionalFeedback.size() >= 1
        ))
        && (!suspending || (
          after.active == false
          && after.submittedVersion == null
          && after.approvedVersion == before.approvedVersion
          && after.approvedCategoryIds == before.approvedCategoryIds
          && after.approvedSpecialtyIds == before.approvedSpecialtyIds
          && after.approvedBaseCityIbgeCode == before.approvedBaseCityIbgeCode
          && after.approvedSelectedCityIbgeCodes
            == before.approvedSelectedCityIbgeCodes
          && after.eligibleCityIbgeCodes == before.eligibleCityIbgeCodes
          && after.professionalFeedback is string
          && after.professionalFeedback.size() >= 1
        ))
        && (!activeChange || (
          after.reviewStatus == before.reviewStatus
          && after.profileVersion == before.profileVersion
          && after.submittedVersion == before.get('submittedVersion', null)
          && after.approvedVersion == before.approvedVersion
          && after.professionalFeedback
            == before.get('professionalFeedback', null)
          && after.approvedCategoryIds == before.approvedCategoryIds
          && after.approvedSpecialtyIds == before.approvedSpecialtyIds
          && after.approvedBaseCityIbgeCode == before.approvedBaseCityIbgeCode
          && after.approvedSelectedCityIbgeCodes
            == before.approvedSelectedCityIbgeCodes
          && after.eligibleCityIbgeCodes == before.eligibleCityIbgeCodes
          && (after.active == false || (
            after.reviewStatus == 'APPROVED'
            && after.approvedVersion == after.profileVersion
          ))
        ))
        && event.action == (activeChange
          ? (after.active ? 'ACTIVATED' : 'DEACTIVATED')
          : (suspending
            ? 'SUSPENDED'
            : after.reviewStatus))
        && (!activeChange || (
          event.reason is string
          && event.reason.size() >= 1
          && event.reason.size() <= 1200
        ))
        && (!decision
            && !suspending
          || event.reason == after.professionalFeedback)
        && hasValidReviewEvent(professionalId, after.lastEventId)
        && event.actorRole == 'ADMIN'
        && event.fromStatus == before.reviewStatus
        && event.toStatus == after.reviewStatus
        && event.profileVersion == before.profileVersion
        && ((decision
            && event.reviewedVersion == before.profileVersion)
          || (!decision
            && event.reviewedVersion == before.approvedVersion));
    }

    match /users/{userId} {
      allow create: if isDocumentOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'roles',
          'activeMode',
          'professionalProfileStatus',
          'createdAt',
          'updatedAt',
          'legalAcceptances'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() <= 320
        && request.resource.data.roles is list
        && request.resource.data.roles.size() == 0
        && request.resource.data.activeMode == null
        && request.resource.data.professionalProfileStatus == 'not-started'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasValidLegalAcceptances();

      allow read: if isDocumentOwner(userId);
      allow update: if isDocumentOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'roles',
          'activeMode',
          'professionalProfileStatus',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['name'])
          || (request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 120))
        && hasValidRoleConfiguration()
        && hasValidProfessionalProfileSummary(userId)
        && (hasNoConfiguredRoles()
          || request.resource.data.roles == resource.data.get('roles', [])
          || isGrantedRoleExpansion(userId));

      allow delete: if false;
    }

    // Grants são emitidos exclusivamente por um backend confiável usando o
    // Admin SDK. Clientes não podem criá-los, alterá-los ou consultá-los.
    match /roleEnablementGrants/{userId}/roles/{role} {
      allow read, write: if false;
    }

    // A credencial administrativa é provisionada e revogada somente por um
    // responsável confiável no Firebase Console. O cliente web pode observar
    // apenas o documento associado ao próprio UID e nunca pode escrevê-lo.
    match /adminAccess/{userId} {
      allow get: if isDocumentOwner(userId);
      allow list, create, update, delete: if false;
    }

    // Namespace reservado para dados operacionais das próximas entregas.
    // Leituras exigem a mesma credencial ativa; nenhuma escrita web é aberta.
    match /adminData/{document=**} {
      allow read: if isActiveAdmin();
      allow write: if false;
    }

    // Fonte única do estado de análise e elegibilidade profissional.
    match /professionalOperationalProfiles/{professionalId} {
      allow get: if isDocumentOwner(professionalId) || isActiveAdmin();
      allow list: if isActiveAdmin();
      allow create: if isInitialProfessionalReview(professionalId);
      allow update: if isProfessionalReviewTransition(professionalId)
        || isAdministrativeReviewTransition(professionalId);
      allow delete: if false;

      match /events/{eventId} {
        allow get: if isDocumentOwner(professionalId) || isActiveAdmin();
        allow list: if (isDocumentOwner(professionalId) || isActiveAdmin())
          && request.query.limit != null
          && request.query.limit <= 50;
        allow create: if (isDocumentOwner(professionalId) || isActiveAdmin())
          && ((isDocumentOwner(professionalId)
              && request.resource.data.actorRole == 'PROFESSIONAL')
            || (isActiveAdmin()
              && request.resource.data.actorRole == 'ADMIN'))
          && getAfter(
            /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
          ).data.lastEventId == eventId
          && ((!exists(
              /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
            )
            && existsAfter(
              /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
            ))
            || (exists(
                /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
              )
              && getAfter(
                /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
              ).data.revision == get(
                /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
              ).data.revision + 1));
        allow update, delete: if false;
      }
    }

    // Notas internas nunca compartilham um documento legível pelo profissional.
    match /professionalReviewInternal/{professionalId}/events/{eventId} {
      allow get: if isActiveAdmin();
      allow list: if isActiveAdmin()
        && request.query.limit != null
        && request.query.limit <= 50;
      allow create: if isActiveAdmin()
        && hasValidInternalReviewEvent(
          professionalId,
          eventId,
          request.resource.data.action,
          request.resource.data.reviewedVersion
        )
        && getAfter(
          /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
        ).data.lastEventId == eventId
        && getAfter(
          /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
        ).data.revision == get(
          /databases/$(database)/documents/professionalOperationalProfiles/$(professionalId)
        ).data.revision + 1;
      allow update, delete: if false;
    }

    // Disponibilidade discreta por data/período. A reserva em coleção separada
    // é a trava única que impede dois atendimentos no mesmo slot.
    match /professionalAvailability/{professionalId}/slots/{slotId} {
      allow get: if isDocumentOwner(professionalId) || isActiveAdmin();
      allow list: if false;
      allow create, update: if isDocumentOwner(professionalId)
        && request.resource.data.keys().hasAll([
          'professionalId', 'serviceDate', 'period', 'available', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'professionalId', 'serviceDate', 'period', 'available', 'updatedAt'
        ])
        && request.resource.data.professionalId == professionalId
        && slotId == request.resource.data.serviceDate
          + '_' + request.resource.data.period
        && request.resource.data.serviceDate is string
        && request.resource.data.period in ['MORNING', 'AFTERNOON', 'EVENING']
        && request.resource.data.available is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isDocumentOwner(professionalId)
        && !exists(
          /databases/$(database)/documents/professionalReservations/$(professionalId)/slots/$(slotId)
        );
    }

    match /serviceRequests/{requestId} {
      // O resumo não contém endereço ou contato. Profissionais aprovados podem
      // executar queries de oportunidades; matching volta a ser validado no aceite.
      allow list: if request.auth != null
        && (isActiveAdmin()
          || (resource.data.status == 'OPEN'
            && professionalMatchesOpportunity(
              resource.data,
              request.auth.uid
            )));
      allow get: if canReadServiceRequest(requestId);
      allow create, delete: if false;
      allow update: if request.auth != null
        && (isAcceptanceTransition(requestId, request.auth.uid)
          || isCancellationTransition(requestId, request.auth.uid));

      match /rounds/{roundId} {
        allow get: if canReadServiceRequest(requestId);
        allow list: if false;
        allow create: if request.auth != null
          && isCancellationTransition(requestId, request.auth.uid)
          && getAfter(
            /databases/$(database)/documents/serviceRequests/$(requestId)
          ).data.currentRoundId == roundId;
        allow update: if request.auth != null
          && isAcceptanceTransition(requestId, request.auth.uid)
          && get(
            /databases/$(database)/documents/serviceRequests/$(requestId)
          ).data.currentRoundId == roundId;
        allow delete: if false;

        match /refusals/{professionalId} {
          allow get: if isDocumentOwner(professionalId) || isActiveAdmin();
          allow list: if false;
          allow create: if isRefusalCreate(
            requestId,
            roundId,
            professionalId
          );
          allow update, delete: if false;
        }
      }

      match /assignments/{assignmentId} {
        allow get: if request.auth != null
          && (isActiveAdmin()
            || (resource != null
              && (request.auth.uid == resource.data.clientId
                || request.auth.uid == resource.data.professionalId)));
        allow list: if false;
        allow create: if request.auth != null
          && isAcceptanceTransition(requestId, request.auth.uid)
          && getAfter(
            /databases/$(database)/documents/serviceRequests/$(requestId)
          ).data.currentAssignmentId == assignmentId;
        allow update: if request.auth != null
          && isCancellationTransition(requestId, request.auth.uid)
          && get(
            /databases/$(database)/documents/serviceRequests/$(requestId)
          ).data.currentAssignmentId == assignmentId;
        allow delete: if false;
      }

      match /events/{eventId} {
        allow get: if request.auth != null
          && (isActiveAdmin()
            || (resource != null
              && request.auth.uid == resource.data.actorId)
            || request.auth.uid == get(
              /databases/$(database)/documents/serviceRequests/$(requestId)
            ).data.clientId);
        allow list: if request.auth != null
          && request.query.limit != null
          && request.query.limit <= 50
          && (isActiveAdmin()
            || request.auth.uid == get(
              /databases/$(database)/documents/serviceRequests/$(requestId)
            ).data.clientId
            || request.auth.uid == resource.data.actorId);
        allow create: if request.auth != null
          && request.resource.data.eventId == eventId
          && ((request.resource.data.type == 'REQUEST_ASSIGNED'
              && isAcceptanceTransition(requestId, request.auth.uid))
            || (request.resource.data.type == 'PROFESSIONAL_REFUSED'
              && isRefusalCreate(
                requestId,
                get(
                  /databases/$(database)/documents/serviceRequests/$(requestId)
                ).data.currentRoundId,
                request.auth.uid
              ))
            || (request.resource.data.type
                == 'PROFESSIONAL_CANCELLED_AND_REOPENED'
              && isCancellationTransition(requestId, request.auth.uid)));
        allow update, delete: if false;
      }
    }

    // Endereço, contato e observações ficam fora do resumo consultado no feed.
    // O antigo responsável perde a leitura assim que a solicitação é reaberta.
    match /serviceRequestPrivate/{requestId} {
      allow get: if request.auth != null
        && exists(
          /databases/$(database)/documents/serviceRequests/$(requestId)
        )
        && (request.auth.uid == get(
            /databases/$(database)/documents/serviceRequests/$(requestId)
          ).data.clientId
          || request.auth.uid == get(
            /databases/$(database)/documents/serviceRequests/$(requestId)
          ).data.assignedProfessionalId
          || isActiveAdmin());
      allow list, write: if false;
    }

    match /professionalReservations/{professionalId}/slots/{slotId} {
      allow get: if isDocumentOwner(professionalId)
        || (request.auth != null
          && resource != null
          && request.auth.uid == get(
            /databases/$(database)/documents/serviceRequests/$(resource.data.requestId)
          ).data.clientId)
        || isActiveAdmin();
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == professionalId
        && request.resource.data.reservationId == slotId
        && isAcceptanceTransition(
          request.resource.data.requestId,
          professionalId
        );
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == professionalId
        && resource.data.reservationId == slotId
        && isCancellationTransition(resource.data.requestId, professionalId);
    }

    // O catálogo é público, mas sua manutenção acontece somente por
    // ambientes administrativos confiáveis, que usam um SDK de servidor.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /specialties/{specialtyId} {
      allow read: if true;
      allow write: if false;
    }

    // O perfil do cliente não é público. Nome e e-mail permanecem na identidade
    // users/{userId}; aqui ficam somente dados específicos e privados do cliente.
    match /clientProfiles/{userId} {
      allow read: if isDocumentOwner(userId);

      allow create: if isDocumentOwner(userId)
        && hasClientRole(userId)
        && hasValidClientProfile(request.resource.data, userId)
        && request.resource.data.createdAt == request.time;

      allow update: if isDocumentOwner(userId)
        && hasClientRole(userId)
        && resource.data.ownerId == userId
        && request.resource.data.ownerId == userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phone', 'profileImage', 'updatedAt'
        ])
        && hasValidClientProfile(request.resource.data, userId);

      allow delete: if false;
    }

    match /professionalProfiles/{userId} {
      allow read: if isDocumentOwner(userId)
        || (resource.data.status == 'PUBLISHED'
          && resource.data.get('serviceMode', null) in [
            'CITY_ONLY', 'RADIUS', 'SELECTED_CITIES'
          ]);

      allow create: if isDocumentOwner(userId)
        && hasProfessionalRole(userId)
        && request.resource.data.ownerId == userId
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'publicName',
          'headline',
          'bio',
          'categoryIds',
          'specialtyIds',
          'experienceYears',
          'baseLocation',
          'serviceMode',
          'serviceRadiusKm',
          'selectedCities',
          'selectedCityIbgeCodes',
          'availability',
          'contactVisibility',
          'phone',
          'profileImage',
          'portfolioImages',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.status in ['DRAFT', 'PUBLISHED']
        && request.resource.data.createdAt == request.time
        && hasValidProfessionalProfileFields()
        && (request.resource.data.status == 'DRAFT'
          || isPublishableProfessionalProfile())
        && existsAfter(
          /databases/$(database)/documents/professionalOperationalProfiles/$(userId)
        );

      allow update: if isDocumentOwner(userId)
        && hasProfessionalRole(userId)
        && resource.data.ownerId == userId
        && request.resource.data.ownerId == userId
        && resource.data.status != 'SUSPENDED'
        && request.resource.data.status in ['DRAFT', 'PUBLISHED', 'PAUSED']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'publicName',
          'headline',
          'bio',
          'categoryIds',
          'specialtyIds',
          'experienceYears',
          'baseLocation',
          'serviceMode',
          'serviceRadiusKm',
          'selectedCities',
          'selectedCityIbgeCodes',
          'availability',
          'contactVisibility',
          'phone',
          'profileImage',
          'portfolioImages',
          'status',
          'updatedAt'
        ])
        && hasValidProfessionalProfileUpdate()
        && (request.resource.data.status == 'DRAFT'
          || isPublishableProfessionalProfile())
        && ((professionalReviewFieldsChanged(
              resource.data, request.resource.data
            )
            && getAfter(
              /databases/$(database)/documents/professionalOperationalProfiles/$(userId)
            ).data.revision == get(
              /databases/$(database)/documents/professionalOperationalProfiles/$(userId)
            ).data.get('revision', 0) + 1)
          || (!professionalReviewFieldsChanged(
              resource.data, request.resource.data
            )
            && ((!exists(
                /databases/$(database)/documents/professionalOperationalProfiles/$(userId)
              )
              && (existsAfter(
                  /databases/$(database)/documents/professionalOperationalProfiles/$(userId)
                )
                || request.resource.data.status == resource.data.status))
              || (exists(
                  /databases/$(database)/documents/professionalOperationalProfiles/$(userId)
                )
                && getAfter(
                /databases/$(database)/documents/professionalOperationalProfiles/$(userId)
                ).data == get(
                  /databases/$(database)/documents/professionalOperationalProfiles/$(userId)
                ).data
                && (request.resource.data.status == resource.data.status
                  || !(get(
                    /databases/$(database)/documents/professionalOperationalProfiles/$(userId)
                  ).data.reviewStatus in ['DRAFT', 'CHANGES_REQUESTED']))))));

      allow delete: if false;
    }

    // CEP, bairro e telefone privado ficam isolados do documento consultado
    // por visitantes. Backends que usam o Admin SDK não dependem destas regras.
    match /professionalPrivateProfiles/{userId} {
      allow read: if isDocumentOwner(userId);

      allow create: if isDocumentOwner(userId)
        && hasProfessionalRole(userId)
        && hasValidProfessionalPrivateProfile(request.resource.data, userId);

      allow update: if isDocumentOwner(userId)
        && hasProfessionalRole(userId)
        && resource.data.ownerId == userId
        && hasValidProfessionalPrivateProfile(request.resource.data, userId);

      allow delete: if false;
    }
  }
}
